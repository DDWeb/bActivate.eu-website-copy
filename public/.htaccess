# 301 redirects — renamed blog slugs (K5)
Redirect 301 /blog/taming-the-troublemaker-a-guide-to-handling-endometritis-in-mares-2-2-2 /blog/how-bactivate-tackles-dormant-bacteria-in-mares
Redirect 301 /blog/taming-the-troublemaker-a-guide-to-handling-endometritis-in-mares-2-2 /blog/enhancing-mare-fertility-bactivate-revolutionary-approach
Redirect 301 /blog/taming-the-troublemaker-a-guide-to-handling-endometritis-in-mares-2 /blog/addressing-challenges-of-problem-mares

# SPA routing — redirect all non-file requests to index.html
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.html [L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
